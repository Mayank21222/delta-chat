# LLM provider: "ollama" (default, local) or "mock" (offline, deterministic,
# used by CI / eval runs where no model server is available).
LLM_PROVIDER=ollama

# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# OCR (only used by the scanned-PDF adapter; defaults are usually fine on
# a standard tesseract + poppler install, override if binaries are elsewhere)
# TESSERACT_CMD=/usr/bin/tesseract
